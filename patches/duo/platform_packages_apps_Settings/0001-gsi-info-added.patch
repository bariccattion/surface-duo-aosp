From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Bariccatti <bariccatti@gmail.com>
Date: Sat, 18 Apr 2026 00:00:00 -0400
Subject: [PATCH] Add Surface Duo GSI info to About screen

---
 res/values/strings.xml     | 3 +++
 res/xml/my_device_info.xml | 7 +++++++
 2 files changed, 10 insertions(+)

diff --git a/res/values/strings.xml b/res/values/strings.xml
index 0000000000..1111111111 100644
--- a/res/values/strings.xml
+++ b/res/values/strings.xml
@@ -13891,6 +13891,9 @@
     <!-- Text for Search bar of Settings home screen [CHAR LIMIT=34] -->
     <string name="homepage_search">Search Settings</string>
 
+    <string name="gsi_info">System Image</string>
+    <string name="gsi_info_summary">Surface Duo AOSP (github.com/bariccattion/surface-duo-aosp)</string>
+
     <!-- Keywords for contacts storage item [CHAR LIMIT=NONE] -->
     <string name="keywords_contacts_storage">contacts, storage, account</string>
     <!-- Text for Contacts Storage Settings title [CHAR LIMIT=50]-->
diff --git a/res/xml/my_device_info.xml b/res/xml/my_device_info.xml
index 0000000000..1111111111 100644
--- a/res/xml/my_device_info.xml
+++ b/res/xml/my_device_info.xml
@@ -236,6 +236,13 @@
             android:summary="@string/summary_placeholder"
             settings:enableCopying="true"
             settings:controller="com.android.settings.deviceinfo.BuildNumberPreferenceController"/>
+
+        <Preference
+            android:key="gsi_info"
+            android:order="54"
+            android:title="@string/gsi_info"
+            android:summary="@string/gsi_info_summary"
+            settings:enableCopying="true"/>
     </PreferenceCategory>
 
 </PreferenceScreen>
-- 
2.34.1
