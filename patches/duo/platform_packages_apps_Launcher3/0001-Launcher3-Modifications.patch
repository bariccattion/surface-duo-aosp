+    private void alignAllApps(boolean initialX) {
+         WindowManager windowManager = (WindowManager) mLauncher.getSystemService(Context.WINDOW_SERVICE);
+         DisplayMetrics displayMetrics = new DisplayMetrics();
+         windowManager.getDefaultDisplay().getMetrics(displayMetrics);
+         int screenWidth = displayMetrics.widthPixels;
+
+         ActivityAllAppsContainerView<Launcher> appsView = mLauncher.findViewById(R.id.apps_view);
+         View bottomSheetBg = mLauncher.findViewById(R.id.bottom_sheet_background);
+         FrameLayout.LayoutParams params = (FrameLayout.LayoutParams) appsView.getLayoutParams();
+         RelativeLayout.LayoutParams bgParams = (RelativeLayout.LayoutParams) bottomSheetBg.getLayoutParams();
+
+         if (screenWidth > 2500) {
+             params.width = (screenWidth / 2) - 5;
+             if (initialX) {
+                 params.gravity = Gravity.END;
+                 bgParams.leftMargin = (screenWidth / 2) + 5;
+                 bgParams.rightMargin = -(screenWidth / 2);
+             } else {
+                 params.gravity = Gravity.START;
+                 bgParams.leftMargin = 0;
+                 bgParams.rightMargin = 0;
+             }
+
+             int topPadding = appsView.getPaddingTop();
+             int bottomPadding = appsView.getPaddingBottom();
+             appsView.setPadding(10, topPadding, 10, bottomPadding);
+         } else {
+             params.width = ViewGroup.LayoutParams.MATCH_PARENT;
+             params.height = ViewGroup.LayoutParams.MATCH_PARENT;
+             bgParams.leftMargin = 0;
+             bgParams.rightMargin = 0;
+         }
+
+         appsView.setLayoutParams(params);
+         bottomSheetBg.setLayoutParams(bgParams);
+    }
+
     private void cancelLongPress() {
         mLongPressState = STATE_CANCELLED;
     }
