@@ -577,8 +580,14 @@ public class DeviceProfile {
         }
 
         if (shouldShowAllAppsOnSheet(context)) {
-            allAppsPadding.top = allAppsTopPadding;
-            allAppsShiftRange = mDeviceProperties.getHeightPx() - allAppsTopPadding + mInsets.top;
+            float allAppsHeightScale = 0.7f;
+            int widthPx = mDeviceProperties.getWidthPx();
+            int heightPx = mDeviceProperties.getHeightPx();
+            if (widthPx > 2500) {
+                allAppsHeightScale = 0.95f;
